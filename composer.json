{
    "name": "stewart-php/store-redis",
    "description": "Redis backend for Stewart's key-value storage. Non-blocking, over amphp",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.1",
        "amphp/amp": "^3.1",
        "amphp/redis": "^2.0.4",
        "revolt/event-loop": "^1.0.9",
        "stewart-php/contracts": "self.version",
        "stewart-php/store": "self.version",
        "stewart-php/support": "self.version",
        "symfony/dependency-injection": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "stewart-php/runtime": "self.version",
        "stewart-php/testing": "self.version"
    },
    "conflict": {
        "amphp/dns": "<2.2"
    },
    "autoload": {
        "psr-4": {
            "Stewart\\Store\\Redis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stewart\\Store\\Redis\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
